# Copy to .env.local for local development. Never commit real values.

# Supabase project URL (Project Settings > API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key, starts with sb_publishable_ (Project Settings > API keys).
# Safe to expose to the browser: Row Level Security decides what it can read.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key, starts with sb_secret_ (or the legacy service_role key).
# SERVER ONLY. Used by the Admin page to create users. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Phase 2: public half of the push key pair (see README, "Notifications and push"). Safe to expose.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Expenses WhatsApp bot (Meta WhatsApp Cloud API, its own business number). SERVER ONLY. The bot stays off until
# WHATSAPP_BOT_TOKEN and WHATSAPP_BOT_PHONE_ID are set. Webhook address: https://<site>/api/whatsapp/bot
WHATSAPP_BOT_TOKEN=
WHATSAPP_BOT_PHONE_ID=
# App settings > Basic > App secret: checks each webhook really comes from Meta.
WHATSAPP_BOT_APP_SECRET=
# Any long random text; type the same text in Meta's webhook settings.
WHATSAPP_BOT_VERIFY_TOKEN=
# Who may send expenses: number with country code, then a name. "919876543210:Jigar, 918888888888:Aman"
WHATSAPP_BOT_SENDERS=
# Optional. Defaults to v23.0.
WHATSAPP_GRAPH_VERSION=

# Reads payment screenshots (Google AI Studio, free tier). Without it the bot asks for the amount.
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest.
GEMINI_MODEL=
